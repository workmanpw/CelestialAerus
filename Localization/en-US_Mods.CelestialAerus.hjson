		DisplayName: Andromeda's Rage
		Description: The fury of a galaxy fuels your attacks
	}

	CelestialEmpowerment: {
		DisplayName: Celestial Empowerment
		Description: Celestial power surges through you, greatly increasing damage, speed, defense, and regeneration.
	}

	CelestialFlames: {
		DisplayName: Celestial Flames
		Description: Burning with cosmic fire
	}

	CelestialObliteration: {
		DisplayName: Celestial Obliteration
		Description: Taking 2000 damage per tick. Nothing can block or remove this.
	}

	CrushedDefense: {
		DisplayName: Crushed Defense
		Description: Your defenses have been utterly shattered by cosmic power
	}
}

