Items: {
	AncientHatchet: {
		DisplayName: Ancient Hatchet
		Tooltip:
			'''
			Chaos in flames
			An ancient relic that burns with the heat of a legendary forge
			Throws a homing hatchet that explodes into fire on impact and shatters into tiny homing hatchets
			Steals life on hit and inflicts Daybreak
			'''
	}

	AndromedasWrath: {
		DisplayName: Andromeda's Wrath
		Tooltip:
			'''
			The manifested fury of Andromeda Galaxy itself
			"Order!"
			Fires a devastating Andromeda Beam and seeking Andromeda Seekers
			Heals a large amount of life on hit
			'''
	}

	ArkOfTheCelestials: {
		DisplayName: Ark Of The Celestials
		Tooltip:
			'''
			Fires a spread of Celestial Fireballs that rapidly seek targets
			"The universe is in your hands now"
			Heals a large amount of life on hit
			'''
	}

	BrigittesCharm: {
		DisplayName: Brigitte's Charm
		Tooltip:
			'''
			A charm blessed by the Goddess herself
			Grants the power of every accessory
			+600 defense, rapid healing and mana regeneration
			Summons an army of minions, living weapons, and bosses to fight for you
			Calls down a storm of projectiles upon your enemies
			'''
	}

	CelestialAerus: {
		DisplayName: Celestial Aerus
		Tooltip:
			'''
			The legendary blade forged from the heart of a dying universe
			'When the last star falls, a new light is born'
			Shoots homing Celestial Fireballs and cosmic blades
			Switch between different attacks (default: V, rebindable)
			Heals 125 life on hit
			'''
	}

	CelestialTempest: {
		DisplayName: Celestial Tempest
		Tooltip:
			'''
			The storm that rages between dimensions
			You will know Judgement
			Fires different projectiles and heals a large amount of life on hit
			The ultimate fusion of all cosmic forces
			'''
	}

	Cosmosis: {
		DisplayName: Cosmosis
		Tooltip:
			'''
			The embodiment of cosmic order
			From chaos comes order, from order comes infinity
			Commands fundamental forces of the universe
			Fires a homing Cosmo Beam and seeks out enemies with Cosmo Seekers
			Heals a large amount of life on hit
			'''
	}

	NebulaBlazeSword: {
		DisplayName: Nebula Blaze
		Tooltip:
			'''
			A stunning pink blade with a hatred for all creatures
			It is very volatile and dangerous
			Do not mistake it for candy
			Rains cosmic energy onto enemies
			Bolts burst into living nebulae that tear through everything
			'''
	}

	SpaceLaserRemote: {
		DisplayName: Space Laser Remote
		Tooltip:
			'''
			A device of untold, unmatched power
			It is extremely dangerous
			Do not use in towns
			'Make sure you point it away from yourself, lest you become a pile of ash.'
			'''
	}

	Firstlight: {
		DisplayName: Firstlight
		Tooltip:
			'''
			The first blade the Aerus smiths ever forged, and the first light of their craft
			Built as a trial weapon to prove mortal steel could hold starlight -- it passed, and every Aerus weapon since is measured against it
			Fires homing rainbow bolts that pass through tiles
			'''
	}

	ThreadOfTheEmpyrean: {
		DisplayName: Thread Of The Empyrean
		Tooltip:
			'''
			Greatness on a string
			Tosses an extremely hasty yo-yo
			Fires Celestial Fireballs that rapidly seek targets
			Rumor has it that this yo-yo is very dangerous
			'''
	}
}

